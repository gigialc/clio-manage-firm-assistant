# Public HTTPS origin after deployment. Do not include a trailing slash.
PUBLIC_BASE_URL=https://clio-assistant.example.com

# Clio Developer App values. Store these in the host's secret manager.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=https://clio-assistant.example.com/oauth/clio/callback
CLIO_REGION=US

# Production PostgreSQL database and a 32-byte base64 encryption key.
DATABASE_URL=
TOKEN_ENCRYPTION_KEY=

PORT=3000
TRUST_PROXY=1
